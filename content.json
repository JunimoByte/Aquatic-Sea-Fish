{
    "Format": "2.8.0",
    "ConfigSchema": {
        "Fish Difficulty": {
            "AllowValues": "Default, Relaxed",
            "Default": "Default"
        },
        "Protected Edibility": {
            "AllowValues": "Default, Enabled",
            "Default": "Default"
        }
    },
    "Changes": [
        {
            "Action": "Load",
            "Target": "Mods/{{ModID}}/FishSprite",
            "FromFile": "assets/FishSprite.png"
        },
        {
            "Action": "Load",
            "Target": "Mods/{{ModID}}/ObjectSprite",
            "FromFile": "assets/ObjectSprite.png"
        },
        {
            "Action": "Load",
            "Target": "Mods/{{ModID}}/AquariumSprite",
            "FromFile": "assets/AquariumSprite.png"
        },
        {
            "Action": "Include",
            "FromFile": "code/Fish/fish.json, code/Fish/objects.json,code/Fish/aquarium.json, code/Fish/behavior.json, code/Fish/locations.json, code/Fish/pond.json"
        },
        {
            "Action": "Include",
            "FromFile": "code/Events/mail.json, code/Events/quests.json, code/Events/triggers.json"
        },
        {
            "Action": "Include",
            "FromFile": "code/NPCs/dialogue.json, code/NPCs/gifts.json"
        },
        {
            "Action": "Include",
            "FromFile": "code/Other/config.json"
        },
        {
            "Action": "Include",
            "FromFile": "code/Compat/index.json"
        },
        {
            "Action": "Include",
            "FromFile": "code/Other/artifacts.json, code/Other/tailoring.json, code/Other/forage.json"
        }
    ]
}